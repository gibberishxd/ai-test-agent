# Copy to .env and fill in. Never commit .env.

# --- Database ---
# Host port for the Docker Postgres. Change it (and DATABASE_URL) if 5432 is already in use.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent

# --- AI provider ---
# Which LLMClient the worker uses: claude | ollama | fake.
# Leave empty to pick automatically: claude if ANTHROPIC_API_KEY is set, otherwise fake.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Claude model for action decisions and bug judgement (the expensive, important calls).
AGENT_MODEL=claude-sonnet-5-5
# Claude model for summaries, dedup and benchmark matching (cheap, high volume).
CHEAP_MODEL=claude-haiku-5-5
# Local Ollama server and model. The model must support images (vision) and tool calls.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b-instruct
# Benchmark judge: the model that matches the agent's reports to the planted bugs. Pin it so
# results for different agent models are judged by the same model (e.g. JUDGE_PROVIDER=ollama,
# JUDGE_MODEL=gemma4:12b). Empty = the agent's own provider and cheap model.
JUDGE_PROVIDER=
JUDGE_MODEL=

# --- Run budgets (enforced by the worker, never by the model) ---
MAX_STEPS=40
MAX_RUN_SECONDS=480
MAX_RUN_COST_USD=1.00
# Loop detection: stop when the same action repeats this many times in a row without changing
# the page (or twice this many times even if the page changes).
MAX_REPEATED_ACTIONS=3

# --- Passive scan ---
MAX_PAGES=30
MAX_DEPTH=5
# Pages whose screenshot the model reviews for visual/UX problems (0 = no model review).
REVIEW_PAGES=6

# --- Sign-in (Auth.js) ---
# Required in production: a long random string (e.g. `openssl rand -base64 32`).
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# GitHub OAuth app (github.com/settings/developers), callback URL:
#   http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Email magic links: an SMTP URL and a sender, e.g. smtp://user:pass@smtp.example.com:587
EMAIL_SERVER=
EMAIL_FROM=

# --- Reverse proxy ---
# Set to true ONLY when the web app runs behind a reverse proxy you control (it appends the
# real client IP to X-Forwarded-For). The visitor rate limit then uses the entry that proxy
# wrote. Without it the header is ignored (anyone can send it) and the socket address is used.
TRUST_PROXY=
# How many trusted proxies are in front of the app (default 1).
TRUSTED_PROXY_HOPS=

# --- Targets ---
DEMO_URL=http://localhost:5173
CLEAN_DEMO_URL=http://localhost:5174
# Dev mode allows our own localhost apps (demo shops) past the private-network guard.
# It is OFF unless set to true here: never set it in production.
DEV_MODE=true
# Where the worker stores screenshots (local disk storage).
DATA_DIR=apps/worker/data
