# Copy to .env and fill in. Never commit .env.

# --- Database ---
# Host port for the Docker Postgres. Change it (and DATABASE_URL) if 5432 is already in use.
POSTGRES_PORT=5432
# The admin connection: migrations, test databases, `npm run db:roles`, maintenance commands.
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
# Each app's own role (run 5, K3): not a superuser, can't bypass row-level security. Create the
# roles' passwords with `npm run db:roles` (it reads DB_*_PASSWORD), then set these. Unset, the
# apps fall back to DATABASE_URL. Dev-only passwords below; production sets its own.
DB_WEB_PASSWORD=ata_web_dev
DB_WORKER_PASSWORD=ata_worker_dev
WEB_DATABASE_URL=postgresql://ata_web:ata_web_dev@localhost:5432/agent
WORKER_DATABASE_URL=postgresql://ata_worker:ata_worker_dev@localhost:5432/agent

# --- AI provider ---
# Which LLMClient the worker uses: claude | ollama | fake.
# Leave empty to pick automatically: claude if ANTHROPIC_API_KEY is set, otherwise fake.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Claude model for action decisions and bug judgement (the expensive, important calls).
AGENT_MODEL=claude-sonnet-5-5
# Claude model for summaries, dedup and benchmark matching (cheap, high volume).
CHEAP_MODEL=claude-haiku-5-5
# Local Ollama server and model. The model must support images (vision) and tool calls.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b-instruct
# Benchmark judge: the model that matches the agent's reports to the planted bugs. Pin it so
# results for different agent models are judged by the same model (e.g. JUDGE_PROVIDER=ollama,
# JUDGE_MODEL=gemma4:12b). Empty = the agent's own provider and cheap model.
JUDGE_PROVIDER=
JUDGE_MODEL=

# Reviewer tier (run 5, K2): a stronger model that decides on flagged steps and on the final
# candidate list, while LLM_PROVIDER's model explores. Any provider. Both empty = no reviewer;
# only REVIEWER_MODEL = the explorer's provider with that model.
REVIEWER_PROVIDER=
REVIEWER_MODEL=
# false for a reviewer that can't read images (e.g. qwen3:14b): it gets the same evidence as text.
REVIEWER_VISION=true

# Any OpenAI-style chat completions API as the server's model (LLM_PROVIDER=openai-compat):
# OpenAI, Gemini's OpenAI endpoint, OpenRouter, Groq, LM Studio, vLLM, Ollama's /v1.
# Prices are USD per million tokens (for the cost budget); 0 if unknown.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_CHEAP_MODEL=
OPENAI_COMPAT_INPUT_PRICE=
OPENAI_COMPAT_OUTPUT_PRICE=
# LLM_PROVIDER=claude-cli: the `claude` command with your own Claude login, for LOCAL testing
# only (needs DEV_MODE=true, refuses NODE_ENV/ENV=production, uses your plan's limits).

# --- Workspace models ("bring any model", Settings → Models) ---
# Encrypts the API keys workspaces paste in (AES-256-GCM). 32 random bytes in base64:
#   openssl rand -base64 32
# Both the web app and the worker need the same value. Without it, keys can't be saved.
MODEL_KEYS_SECRET=

# --- Run budgets (enforced by the worker, never by the model) ---
MAX_STEPS=40
MAX_RUN_SECONDS=480
MAX_RUN_COST_USD=1.00
# Loop detection: stop when the same action repeats this many times in a row without changing
# the page (or twice this many times even if the page changes).
MAX_REPEATED_ACTIONS=3

# --- Passive scan ---
MAX_PAGES=30
MAX_DEPTH=5
# Pages whose screenshot the model reviews for visual/UX problems (0 = no model review).
REVIEW_PAGES=6

# --- Sign-in (Auth.js) ---
# Required in production: a long random string (e.g. `openssl rand -base64 32`).
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# GitHub OAuth app (github.com/settings/developers), callback URL:
#   http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Email magic links: an SMTP URL and a sender, e.g. smtp://user:pass@smtp.example.com:587
EMAIL_SERVER=
EMAIL_FROM=

# --- Reverse proxy ---
# Set to true ONLY when the web app runs behind a reverse proxy you control (it appends the
# real client IP to X-Forwarded-For). The visitor rate limit then uses the entry that proxy
# wrote. Without it the header is ignored (anyone can send it) and the socket address is used.
TRUST_PROXY=
# How many trusted proxies are in front of the app (default 1).
TRUSTED_PROXY_HOPS=

# --- Targets ---
DEMO_URL=http://localhost:5173
CLEAN_DEMO_URL=http://localhost:5174
# Dev mode allows our own localhost apps (demo shops) past the private-network guard.
# It is OFF unless set to true here: never set it in production.
DEV_MODE=true
# Where the worker stores screenshots (local disk storage).
DATA_DIR=apps/worker/data

# --- Run 4: production settings (docs/DEPLOY.md) ---------------------------------------------
# Screenshots: local disk (default) or an S3-compatible bucket (MinIO, S3, R2).
STORAGE=local
S3_BUCKET=screenshots
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# /api/metrics needs "Authorization: Bearer <token>" when this is set.
METRICS_TOKEN=
# json: one JSON object per log line (production).
LOG_FORMAT=
# The production compose profile's database password (docker-compose.yml, profile prod).
PROD_DB_PASSWORD=
# Also set DB_WEB_PASSWORD and DB_WORKER_PASSWORD (Database, above) to long random values:
# the migrate job sets them on the roles, and the web app and workers connect with them.
# The app's public address (API links, invitations).
PUBLIC_BASE_URL=http://localhost:3000
