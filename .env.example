# Copy to .env and fill in. Never commit .env.

# --- Database ---
# Host port for the Docker Postgres. Change it (and DATABASE_URL) if 5432 is already in use.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent

# --- AI provider ---
# Which LLMClient the worker uses: claude | ollama | fake.
# Leave empty to pick automatically: claude if ANTHROPIC_API_KEY is set, otherwise fake.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Claude model for action decisions and bug judgement (the expensive, important calls).
AGENT_MODEL=claude-sonnet-5-5
# Claude model for summaries, dedup and benchmark matching (cheap, high volume).
CHEAP_MODEL=claude-haiku-5-5
# Local Ollama server and model. The model must support images (vision) and tool calls.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b

# --- Run budgets (enforced by the worker, never by the model) ---
MAX_STEPS=40
MAX_RUN_SECONDS=480
MAX_RUN_COST_USD=1.00
# Stop when the same action repeats this many times in a row (loop detection).
MAX_REPEATED_ACTIONS=3

# --- Passive scan ---
MAX_PAGES=30
MAX_DEPTH=5
# Pages whose screenshot the model reviews for visual/UX problems (0 = no model review).
REVIEW_PAGES=6

# --- Targets ---
DEMO_URL=http://localhost:5173
CLEAN_DEMO_URL=http://localhost:5174
# Dev mode allows our own localhost apps (demo shops) past the private-network guard.
DEV_MODE=true
# Where the worker stores screenshots (local disk storage).
DATA_DIR=apps/worker/data
