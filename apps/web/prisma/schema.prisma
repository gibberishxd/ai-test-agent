// The database schema. Prisma owns it and its migrations; the Python worker mirrors it with
// SQLAlchemy (apps/worker/src/worker/db/models.py) and a test checks the two stay in sync.
//
// Conventions, so both languages can use the same tables:
// - snake_case table and column names (@@map / @map)
// - ids are generated by Postgres (gen_random_uuid()), not by Prisma, so inserts from Python
//   get ids too
// - timestamps default to now() in the database for the same reason

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RunMode {
  passive
  interactive

  @@map("run_mode")
}

enum RunStatus {
  queued
  running
  done
  failed
  stopped

  @@map("run_status")
}

enum Severity {
  critical
  high
  medium
  low

  @@map("severity")
}

enum BugSource {
  deterministic
  agent

  @@map("bug_source")
}

enum BugStatus {
  candidate
  confirmed
  dismissed

  @@map("bug_status")
}

model Workspace {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  slug              String   @unique
  monthlyRunQuota   Int      @default(50) @map("monthly_run_quota")
  /// Proves domain ownership: put it in a DNS TXT record or /.well-known/ai-test-agent.txt.
  verificationToken String   @unique @default(dbgenerated("replace(gen_random_uuid()::text, '-', '')")) @map("verification_token")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  users        User[]
  runs         Run[]
  auditLog     AuditLog[]
  domains      Domain[]
  modelConfigs ModelConfig[]

  @@map("workspaces")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime? @map("email_verified") @db.Timestamptz(3)
  workspaceId   String    @map("workspace_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      Run[]
  auditLog  AuditLog[]
  accounts  Account[]

  @@index([workspaceId])
  @@map("users")
}

/// One test run. The web app inserts it as "queued"; the worker claims it with
/// SELECT ... FOR UPDATE SKIP LOCKED and writes progress, cost and the result back.
model Run {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  createdById   String?   @map("created_by_id") @db.Uuid
  targetUrl     String    @map("target_url")
  mode          RunMode   @default(passive)
  focus         String?
  status        RunStatus @default(queued)
  /// Set by the Stop button; the worker checks it between steps.
  stopRequested Boolean   @default(false) @map("stop_requested")
  /// Which worker process claimed the run (hostname:pid).
  claimedBy     String?   @map("claimed_by")
  provider      String?
  model         String?
  pagesVisited  Int       @default(0) @map("pages_visited")
  stepCount     Int       @default(0) @map("step_count")
  inputTokens   Int       @default(0) @map("input_tokens")
  outputTokens  Int       @default(0) @map("output_tokens")
  costUsd       Float     @default(0) @map("cost_usd")
  error         String?
  /// Summary written when the run finishes (Report model in the worker).
  summary       Json?
  /// Unguessable token for a read-only share link; null = not shared (or revoked).
  shareToken    String?   @unique @map("share_token")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt     DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(3)
  /// The worker's lease: renewed every few seconds while it works (database clock). A running
  /// run whose heartbeat is older than the lease belongs to a dead worker and is failed.
  heartbeatAt   DateTime? @map("heartbeat_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  steps     Step[]
  bugs      Bug[]

  @@index([status, createdAt])
  @@index([workspaceId, createdAt])
  @@map("runs")
  /// The workspace model this run uses; null = the worker's own (server default) model.
  modelConfigId String?      @map("model_config_id") @db.Uuid
  modelConfig   ModelConfig? @relation(fields: [modelConfigId], references: [id], onDelete: SetNull)
}

/// One thing the worker did during a run: visit a page, click, type, report a bug...
model Step {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId        String   @map("run_id") @db.Uuid
  index        Int
  action       String
  args         Json     @default("{}")
  reasoning    String?
  url          String?
  screenshot   String?
  /// Console errors and network failures seen since the previous step.
  events       Json     @default("[]")
  blocked      Boolean  @default(false)
  blockReason  String?  @map("block_reason")
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  costUsd      Float    @default(0) @map("cost_usd")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, index])
  @@map("steps")
}

model Bug {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId         String    @map("run_id") @db.Uuid
  title         String
  severity      Severity
  category      String
  pageUrl       String    @map("page_url")
  expected      String?
  actual        String?
  /// Numbered repro steps, as a JSON list of strings.
  reproSteps    Json      @default("[]") @map("repro_steps")
  /// Console errors, failed requests, axe violations: hard evidence.
  evidence      Json      @default("{}")
  reasoning     String?
  screenshot    String?
  /// Step indexes that led to the bug (for replay).
  stepIndexes   Int[]     @default([]) @map("step_indexes")
  source        BugSource
  status        BugStatus @default(candidate)
  dismissReason String?   @map("dismiss_reason")
  duplicateOfId String?   @map("duplicate_of_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("bugs")
}

model BenchmarkResult {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider     String
  model        String
  gitCommit    String   @map("git_commit")
  runsBuggy    Int      @map("runs_buggy")
  recall       Float
  precision    Float
  falseAlarms  Float    @map("false_alarms")
  avgCostUsd   Float    @map("avg_cost_usd")
  avgDurationS Float    @map("avg_duration_s")
  /// Recall over the planted bugs that need judgement (not findable by deterministic checks).
  aiRecall           Float?  @map("ai_recall")
  /// The same scores on the holdout app (apps/demo2), which prompts are never tuned against.
  holdoutRunsBuggy   Int?    @map("holdout_runs_buggy")
  holdoutRecall      Float?  @map("holdout_recall")
  holdoutAiRecall    Float?  @map("holdout_ai_recall")
  holdoutPrecision   Float?  @map("holdout_precision")
  holdoutFalseAlarms Float?  @map("holdout_false_alarms")
  /// "provider/model" that matched reports to planted bugs.
  judge              String?
  /// Set when the row came from `bench --rescore`: the commit the rescore ran on.
  rescoreCommit      String? @map("rescore_commit")
  /// Per-bug found/missed and every match decision, for spot checks.
  details      Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([provider, createdAt])
  /// Newest results first: benchmark page, leaderboard, home page (docs/DATABASE.md).
  @@index([createdAt])
  @@map("benchmark_results")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String
  targetUrl   String?  @map("target_url")
  mode        RunMode?
  runId       String?  @map("run_id") @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("audit_log")
}

/// A sign-in method linked to a user (GitHub account), used by Auth.js.
model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// One-time tokens for email magic links, used by Auth.js.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// A domain a workspace wants to test interactively. Verified by DNS TXT or a well-known file.
model Domain {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  hostname    String
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(3)
  method      String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, hostname])
  @@map("domains")
}

/// A model a workspace brings: any OpenAI-compatible endpoint, or Anthropic. The API key is
/// encrypted with AES-256-GCM (server key MODEL_KEYS_SECRET, workspace id as associated data)
/// and never sent back to the browser: only its last 4 characters are shown.
model ModelConfig {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  label            String
  /// "openai-compat" or "claude".
  provider         String
  baseUrl          String?  @map("base_url")
  model            String
  cheapModel       String?  @map("cheap_model")
  apiKeyCiphertext String?  @map("api_key_ciphertext")
  apiKeyLast4      String?  @map("api_key_last4")
  /// USD per million tokens, for the run's cost budget.
  inputPrice       Float    @default(0) @map("input_price")
  outputPrice      Float    @default(0) @map("output_price")
  isDefault        Boolean  @default(false) @map("is_default")
  /// The last "Test connection" result: { ok, answers, tools, vision, error, checkedAt }.
  probe            Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      Run[]

  @@index([workspaceId])
  @@map("model_configs")
}
